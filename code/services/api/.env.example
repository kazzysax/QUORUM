# Contracts (from scripts/deploy-testnet.sh)
COLLECTION=quorum1.you.testnet
DAO=dao.quorum1.you.testnet
TREASURY=treasury.quorum1.you.testnet
MARKET=market.quorum1.you.testnet
# Network
RPC_URL=https://rpc.testnet.near.org
NEARDATA_URL=https://testnet.neardata.xyz
START_HEIGHT=            # block height of your first deploy; empty = start from now
# App
SESSION_SECRET=          # at least 32 random characters: openssl rand -hex 32
APP_RECIPIENT=quorum.app # the `recipient` the frontend passes to signMessage
MEDIA_BASE_URL=http://localhost:8080/media
CORS_ORIGIN=http://localhost:3000
DB_PATH=quorum.db
PORT=8080
# Presale only: {"0": ["alice.testnet", ...]} -> the API serves each account its Merkle proof.
# ALLOWLISTS_FILE=/data/allowlists.json
